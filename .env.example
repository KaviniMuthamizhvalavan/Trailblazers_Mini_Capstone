# LLM Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://your-gateway-url/v1
OPENAI_MODEL=gpt-4o-mini

# Tool Calling Configuration
# If your primary key/gateway does not support tool calling, set NEW_OPENAI_API_KEY with a standard OpenAI key
NEW_OPENAI_API_KEY=
USE_REAL_TOOL_CALLING=true

# Database
DATABASE_URL=sqlite:///./db/learning_path.db

# LangSmith Tracing (Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=Trailblazers_Learning_Path
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
